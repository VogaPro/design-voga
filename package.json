{
  "name": "@voga/ui",
  "version": "0.3.0",
  "description": "Design system Voga — neutro primeiro: tokens + componentes React para todos os projetos.",
  "license": "MIT",
  "author": "Caio Santos",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./data-table": {
      "types": "./dist/data-table/index.d.ts",
      "import": "./dist/data-table/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "audit": "bun scripts/audit.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "smoke": "bun run build && bun scripts/smoke.tsx",
    "check": "bun run typecheck && bun run audit && bun run smoke && bun run playground:build",
    "estatico": "bun run build && bun scripts/estatico.tsx",
    "publicar": "bash scripts/publicar.sh"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.475.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4",
    "recharts": ">=3",
    "react-hook-form": ">=7",
    "@tanstack/react-table": ">=8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.9",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.1",
    "tailwindcss": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.8"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    }
  }
}
